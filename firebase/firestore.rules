rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 進捗の保存。本人のみ
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validSave() {
        return request.resource.data.keys().hasOnly(['state', 'revision'])
          && request.resource.data.keys().hasAll(['state', 'revision'])
          && request.resource.data.state is map
          && request.resource.data.revision is int
          && request.resource.data.revision > 0;
      }
      allow read: if owner();
      // Retain only a deletion marker: old sessions cannot recreate a deleted save.
      allow delete: if owner() && resource.data.state.get('accountDeleted', false) != true;
      allow create: if owner() && validSave() && request.resource.data.revision == 1;
      // Revisionless legacy saves migrate once; stale/old clients cannot bypass CAS.
      allow update: if owner() && validSave()
        && resource.data.state.get('accountDeleted', false) != true
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
    }

    // 「今日の調査員」の集計用。全員が読め、書けるのは本人だけ。
    // 自己申告値ではあるが、公開集計を壊しにくくするため型・必須キー・範囲を検証する。
    match /scouts/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && (!exists(/databases/$(db)/documents/users/$(uid)) || get(/databases/$(db)/documents/users/$(uid)).data.state.get('accountDeleted', false) != true)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day','todayLv','total','lv5'])
        && request.resource.data.keys().hasAll(['day','todayLv','total','lv5'])
        && request.resource.data.day is string
        && request.resource.data.todayLv is int
        && request.resource.data.total is int
        && request.resource.data.lv5 is int
        && request.resource.data.todayLv >= 0
        && request.resource.data.todayLv <= 5
        && request.resource.data.total >= 0
        && request.resource.data.total <= 200
        && request.resource.data.lv5 >= 0
        && request.resource.data.lv5 <= 30;
    }
  }
}
